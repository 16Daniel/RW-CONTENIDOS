
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="generator" content="CoolAdmin 3.4.0" />
    <meta name="description" content="Modern Bootstrap 5 admin dashboard with Chart.js widgets, responsive tables, and clean typography." />
    <title>@ViewBag.Title | Digital Signage</title>

    <link href="~/Content/Admin/css/font-face.css" rel="stylesheet" media="all" />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

    <link href="~/Content/Admin/vendor/fontawesome-7.3.1/css/all.min.css" rel="stylesheet" media="all" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" media="all" />
    <link href="~/Content/Admin/vendor/css-hamburgers/hamburgers.min.css" rel="stylesheet" media="all" />
    <link href="~/Content/Admin/css/theme.css" rel="stylesheet" media="all" />
    <link href="~/Content/Admin/css/app.css" rel="stylesheet" media="all" />
    <link href="~/Content/Styles-Mod/SideBar-Gen.css" rel="stylesheet" media="all" />
    @Styles.Render("~/Content/loader")
</head>

<body class="app" obtenerDatosCuenta="@Url.Action("ObtenerDatosCuenta","Account")" >
    <!-- Carga del loader -->
    @Html.Partial("_Loader")
    <a class="visually-hidden-focusable skip-link" href="#main-content">Skip to main content</a>
    <div class="page-wrapper">

        <!--Menú para portal escritorio-->
        @Html.Partial("_Sidebar")

        <div class="page-container">

            <!-- Encabezado de la pagina -->
            @Html.Partial("_Navbar")

            <!-- Contenido de los módulos -->
            @RenderBody()

            <!-- Footer -->
            @Html.Partial("_Footer")

        </div>
    </div>
    <!-- Para llamadas ajax -->
    @Scripts.Render("~/bundles/jquery")
    <script src="~/Scripts/Admin/js/vanilla-utils.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Content/Admin/vendor/chartjs/chart.umd.js-4.5.1.min.js"></script>
    @*<script src="js/bootstrap5-init.js"></script>*@
    <script src="~/Scripts/Admin/js/main-vanilla.js"></script>
    <script src="~/Scripts/Admin/js/modern-plugins.js"></script>
    @Scripts.Render("~/bundles/loader")
    @Scripts.Render("~/bundles/alerts")
    @RenderSection("scripts", required: false)


</body>
</html>

